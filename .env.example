# Copy to .env. Never commit credentials.
EXCHANGE_ID=binance
MONITORED_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT
COMPARISON_PAIRS=BTC/USDT:ETH/USDT,SOL/USDT:ETH/USDT
EXECUTION_TIMEFRAME=15m
HTF_TIMEFRAME=1h
OHLCV_LIMIT=500
POLL_SECONDS=20
