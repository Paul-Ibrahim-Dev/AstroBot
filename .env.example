MIN_ATR_PCT=0.10
MAX_ATR_PCT=4.0
MIN_RR=2.0
SWING_LOOKBACK=80
COOLDOWN_MINUTES=90
AVOID_UTC_HOURS=
DRY_RUN=true
LOG_LEVEL=INFO
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
